digraph EER {
  rankdir=TB;
  splines=ortho;
  nodesep=0.55;
  ranksep=0.75;
  bgcolor="white";
  node [shape=none, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  // ---------- ENTITY MACRO (HTML-like labels) ----------
  Sede [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>SEDE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_sede</U></TD></TR>
      <TR><TD ALIGN="LEFT">nombre</TD></TR>
      <TR><TD ALIGN="LEFT">direccion</TD></TR>
      <TR><TD ALIGN="LEFT">ciudad</TD></TR>
    </TABLE>>];

  Espacio [peripheries=2, label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#34495e"><FONT COLOR="white"><B>ESPACIO (débil)</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_sede (FK)</U></TD></TR>
      <TR><TD ALIGN="LEFT"><U>numero_espacio</U></TD></TR>
      <TR><TD ALIGN="LEFT">piso</TD></TR>
      <TR><TD ALIGN="LEFT">tipo_espacio</TD></TR>
      <TR><TD ALIGN="LEFT">estado</TD></TR>
    </TABLE>>];

  TipoVehiculo [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>TIPO_VEHICULO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_tipo_vehiculo</U></TD></TR>
      <TR><TD ALIGN="LEFT">nombre</TD></TR>
      <TR><TD ALIGN="LEFT">factor_tarifa</TD></TR>
    </TABLE>>];

  Vehiculo [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>VEHICULO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>placa</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_tipo_vehiculo (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">id_cliente (FK, nulo)</TD></TR>
    </TABLE>>];

  Cliente [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_cliente</U></TD></TR>
      <TR><TD ALIGN="LEFT">nombre</TD></TR>
      <TR><TD ALIGN="LEFT">documento</TD></TR>
      <TR><TD ALIGN="LEFT">telefono</TD></TR>
      <TR><TD ALIGN="LEFT">correo</TD></TR>
    </TABLE>>];

  ClienteOcasional [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#7f8c8d"><FONT COLOR="white"><B>CLIENTE_OCASIONAL</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_cliente (FK)</U></TD></TR>
    </TABLE>>];

  ClienteSuscriptor [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#7f8c8d"><FONT COLOR="white"><B>CLIENTE_SUSCRIPTOR</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_cliente (FK)</U></TD></TR>
      <TR><TD ALIGN="LEFT">fecha_afiliacion</TD></TR>
    </TABLE>>];

  d [shape=diamond, style=filled, fillcolor="#ecf0f1", label="d", width=0.35, height=0.35, fixedsize=true, fontsize=10];

  PlanSuscripcion [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>PLAN_SUSCRIPCION</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_plan</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_tipo_vehiculo (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">nombre</TD></TR>
      <TR><TD ALIGN="LEFT">duracion_dias</TD></TR>
      <TR><TD ALIGN="LEFT">precio</TD></TR>
    </TABLE>>];

  Suscripcion [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>SUSCRIPCION</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_suscripcion</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_cliente (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">placa (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">id_plan (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">fecha_inicio</TD></TR>
      <TR><TD ALIGN="LEFT">fecha_fin</TD></TR>
      <TR><TD ALIGN="LEFT">estado</TD></TR>
    </TABLE>>];

  Tarifa [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>TARIFA</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_tarifa</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_tipo_vehiculo (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">id_sede (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">valor_hora</TD></TR>
      <TR><TD ALIGN="LEFT">vigencia_desde</TD></TR>
      <TR><TD ALIGN="LEFT">vigencia_hasta</TD></TR>
    </TABLE>>];

  Empleado [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>EMPLEADO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_empleado</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_sede (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">nombre</TD></TR>
      <TR><TD ALIGN="LEFT">documento</TD></TR>
      <TR><TD ALIGN="LEFT">cargo</TD></TR>
    </TABLE>>];

  Sesion [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>SESION</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_sesion</U></TD></TR>
      <TR><TD ALIGN="LEFT">placa (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">id_sede (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">numero_espacio (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">id_empleado_cierre (FK, nulo)</TD></TR>
      <TR><TD ALIGN="LEFT">hora_entrada</TD></TR>
      <TR><TD ALIGN="LEFT">hora_salida</TD></TR>
      <TR><TD ALIGN="LEFT">valor_cobrado</TD></TR>
    </TABLE>>];

  Pago [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>PAGO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_pago</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_sesion (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">monto</TD></TR>
      <TR><TD ALIGN="LEFT">metodo_pago</TD></TR>
      <TR><TD ALIGN="LEFT">fecha_pago</TD></TR>
    </TABLE>>];

  Incidencia [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#2c3e50"><FONT COLOR="white"><B>INCIDENCIA</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><U>id_incidencia</U></TD></TR>
      <TR><TD ALIGN="LEFT">id_sesion (FK, nulo)</TD></TR>
      <TR><TD ALIGN="LEFT">id_empleado (FK)</TD></TR>
      <TR><TD ALIGN="LEFT">tipo_incidencia</TD></TR>
      <TR><TD ALIGN="LEFT">descripcion</TD></TR>
      <TR><TD ALIGN="LEFT">fecha</TD></TR>
    </TABLE>>];

  // ---------- RELATIONSHIPS ----------
  Sede -> Espacio [label="1      N", dir=none, penwidth=1.4, style=bold];
  Sede -> Empleado [label="1      N", dir=none];
  Sede -> Tarifa [label="1      N", dir=none];

  TipoVehiculo -> Vehiculo [label="1      N", dir=none];
  TipoVehiculo -> Tarifa [label="1      N", dir=none];
  TipoVehiculo -> PlanSuscripcion [label="1      N", dir=none];

  Cliente -> d [dir=none];
  d -> ClienteOcasional [dir=none, label="  "];
  d -> ClienteSuscriptor [dir=none, label="  "];

  Cliente -> Vehiculo [label="0,1    N", dir=none];
  ClienteSuscriptor -> Suscripcion [label="1      N", dir=none];
  Vehiculo -> Suscripcion [label="1      N", dir=none];
  PlanSuscripcion -> Suscripcion [label="1      N", dir=none];

  Vehiculo -> Sesion [label="1      N", dir=none];
  Espacio -> Sesion [label="1      N", dir=none];
  Empleado -> Sesion [label="0,1    N", dir=none];
  Empleado -> Incidencia [label="1      N", dir=none];
  Sesion -> Incidencia [label="0,1    N", dir=none];
  Sesion -> Pago [label="1      N", dir=none];

  { rank=same; ClienteOcasional; ClienteSuscriptor; }
  { rank=same; Vehiculo; TipoVehiculo; }
  { rank=same; Suscripcion; PlanSuscripcion; Tarifa; }
}
